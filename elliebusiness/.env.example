# ── LLM ─────────────────────────────────────────────────────────────────────
# Primary: OpenRouter (Claude, GPT-4, etc.)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini

# Fallback: Gemini via Google AI Studio (free tier works)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# ── Image Generation ─────────────────────────────────────────────────────────
# GPT Image 2 — requires OpenAI direct (not OpenRouter)
OPENAI_API_KEY=
IMAGE_GEN_MODEL=gpt-image-2

# ── Database ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Etsy ─────────────────────────────────────────────────────────────────────
ETSY_API_KEY=           # keystring — read-only (Nova scraping)
ETSY_SHARED_SECRET=     # OAuth2 secret — needed for write operations
ETSY_ACCESS_TOKEN=      # OAuth2 access token — needed for write operations
ETSY_SHOP_ID=           # numeric shop ID

# ── Printify ──────────────────────────────────────────────────────────────────
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# ── App ───────────────────────────────────────────────────────────────────────
AUTH_TOKEN=dev-token    # Bearer token ELLIE Hub sends with every request

# ── Spend Limits ──────────────────────────────────────────────────────────────
DAILY_LLM_SPEND_LIMIT_USD=10.0
DAILY_IMAGE_SPEND_LIMIT_USD=20.0
